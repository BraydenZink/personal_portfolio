{
  "name": "personal-portfolio",
  "version": "1.0.0",
  "private": true,
  "description": "Personal portfolio of Brayden Zink: a React app served by an Express API on Google Cloud Run.",
  "type": "module",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "dev": "concurrently --names api,web --prefix-colors cyan,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --watch --env-file-if-exists=.env server/index.js",
    "dev:web": "vite",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env server/index.js",
    "lint": "eslint .",
    "spell": "cspell --no-progress \"src/**\" \"server/**\" \"tests/**\" \"docs/*.md\" \"case-studies/*.md\" \"*.md\" \"index.html\"",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run spell && npm test && npm run test:e2e",
    "todo": "grep -rn \"TODO(BRAYDEN)\" server/data || echo \"No placeholders left.\""
  },
  "dependencies": {
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "helmet": "^8.3.0",
    "resend": "^6.37.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "^4.3.4",
    "@vitejs/plugin-react": "^6.2.1",
    "concurrently": "^10.0.6",
    "cspell": "^10.4.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "supertest": "^7.3.1",
    "tailwindcss": "^4.3.4",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
