# Copy this file to .env for local development. Never commit .env.

# API key from https://resend.com/api-keys
RESEND_API_KEY=

# Address that receives contact form messages.
# Without a verified domain, this must be the email on your Resend account.
CONTACT_TO_EMAIL=

# Sender address. This default works without a verified domain.
CONTACT_FROM_EMAIL=Portfolio Contact <onboarding@resend.dev>

# Port for the Express server. Cloud Run sets this automatically.
PORT=8080
